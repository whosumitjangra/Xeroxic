# Secret key used for signing session cookies (HMAC-SHA256)
SESSION_SECRET=super-secret-key-change-this-in-production

# Port for local server (default: 3000)
PORT=3000

# Optional: Persistent cloud storage via Upstash Redis or Vercel KV
# If left unset, local files (or /tmp on Vercel) will be used automatically.
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
