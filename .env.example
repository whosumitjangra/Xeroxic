# ===================================================================
# Xerox Centre — Environment Variables Template
# Copy this file to .env for local development and set production secrets in Vercel.
# ===================================================================

# Secret key used for signing session cookies (HMAC-SHA256, at least 32 random characters)
SESSION_SECRET=your_production_random_secret_here_min_32_chars

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/xerox?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/xerox?retryWrites=true&w=majority

# Admin Passcode for Staff Registration (keep secret)
ADMIN_PASSCODE=YOUR_STRONG_ADMIN_PASSCODE_2026

# Node Environment ('development' or 'production')
NODE_ENV=production

# Local Development Port (default: 3000)
PORT=3000

# Optional: Upstash Redis / Vercel KV REST configuration
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# Razorpay Standard Checkout Configuration
RAZORPAY_KEY_ID=rzp_test_TeOn3Cq5Vfubfu
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Supabase Storage Configuration (Direct 50MB uploads & signed URLs)
SUPABASE_URL=https://bxntxkwanbgrsxylfoih.supabase.co
SUPABASE_KEY=sb_publishable_asOC7HSSZg4dXx6HJ0FvDg_5_qI8Hnv
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here
SUPABASE_BUCKET=pdfs and images

